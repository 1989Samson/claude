# Required: Claude API key (powers the equipment-universe generator and the
# supply hunt). Get one at https://console.anthropic.com and load a little credit.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
# Supply hunt defaults to Haiku for low cost (find-and-extract work):
# SUPPLY_MODEL=claude-haiku-4-5
# Equipment-universe generator defaults to Sonnet (domain reasoning):
# RESEARCH_MODEL=claude-sonnet-4-6
