# Supabase (server + client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (used by migrate/seed/backtest scripts).
# For local dev this points at the local cluster; in CI/prod use the Supabase pooler URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auric_dev

# Claude API, used by the scheduled ingestion to normalize messy lot text.
ANTHROPIC_API_KEY=sk-ant-...
# Model for lot normalization. Default Haiku for cost; override if accuracy needs it.
INGEST_MODEL=claude-haiku-4-5
# Model for the per-asset research agent (web search + reasoning). Sonnet by
# default for research quality. Requires ANTHROPIC_API_KEY on the server.
RESEARCH_MODEL=claude-sonnet-4-6

# Shared secret the ingestion job presents to the import endpoint.
INGEST_API_TOKEN=change-me

# Auction source(s): comma-separated, run in order. Options: gsa, govdeals,
# salvex, govplanet. Example once result URLs are confirmed: govdeals,salvex,gsa
SOURCE=gsa
# Free GSA Auctions key from https://api.data.gov/signup/ (DEMO_KEY for testing).
DATA_GOV_API_KEY=DEMO_KEY
# Optional override if the GSA Auctions endpoint differs from the default.
# GSA_AUCTIONS_URL=https://api.gsa.gov/assets/gsaauctions/v1/auctions

# GovDeals closed-results URL(s), comma-separated. A govdeals.ca host is treated
# as CAD. Confirm the real search endpoint on the first run.
# GOVDEALS_RESULTS_URLS=https://api.govdeals.com/search?status=closed&category=heavy-equipment

# Salvex oil & gas results URL(s), comma-separated.
# SALVEX_RESULTS_URLS=https://www.salvex.com/listings/index.cfm/catid/1294/

# Paid upgrade for real auction comps + FMV/OLV/FLV (drop-in adapter, not yet
# wired): see SOURCES.md.
# EQUIPMENTWATCH_API_KEY=
